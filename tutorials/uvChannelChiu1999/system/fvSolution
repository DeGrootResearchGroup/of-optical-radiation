FoamFile
{
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "p.*"
    {
        solver          GAMG;
        smoother        DIC;
        tolerance       1e-7;
        relTol          0.01;
    }

    "(U|k|epsilon).*"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-6;
        relTol          0.1;
    }
}

PIMPLE
{
    nNonOrthogonalCorrectors 0;
    nCorrectors             2;

    maxCo                   1.0;
    rDeltaTSmoothingCoeff   0.1;
    maxDeltaT               1.0;

    residualControl
    {
        U               1e-3;
        p               5e-3;
        "(k|epsilon)"   1e-3;
    }
}

