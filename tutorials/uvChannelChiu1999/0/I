FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      I;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Per-ray fluence-rate field template. DOM allocates one volScalarField
// of this shape per ray (32 in this single-band 2-D case).

dimensions      [1 0 -3 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    inlet
    {
        // Black exit; no external UV enters.
        type            reflective;
        diffuseFraction 0;
        reflectionCoef  0;
        refValue        uniform 0;
        refGradient     uniform 0;
        valueFraction   uniform 1;
        value           uniform 0;
    }

    outlet
    {
        type            reflective;
        diffuseFraction 0;
        reflectionCoef  0;
        refValue        uniform 0;
        refGradient     uniform 0;
        valueFraction   uniform 1;
        value           uniform 0;
    }

    walls
    {
        // Channel walls: treat as absorbing for the first cut (matches
        // Chiu's PSS treatment which ignored reflection and refraction).
        // Real stainless-steel reflectance at 254 nm is ~5-25 %; toggle
        // reflectionCoef up if matching a specific physical reactor.
        type            reflective;
        diffuseFraction 0;
        reflectionCoef  0;
        refValue        uniform 0;
        refGradient     uniform 0;
        valueFraction   uniform 1;
        value           uniform 0;
    }

    lampWall
    {
        // Lambertian emitter. With the pilot 76 cm arc lamp delivering
        // ~13.8 W of 254 nm radiation (industry-standard 26.7 W/147-cm
        // scaling) less the ~10 % absorbed by the quartz jacket
        // (alpha_q = 0.69 1/cm, t_q = 0.15 cm), the net lamp output is
        // ~12.44 W. Distributed over the lamp arc surface area
        // (pi * D * L_arc = pi * 0.025 * 0.76 = 0.0597 m^2) the
        // radiant exitance is M = 208.5 W/m^2.
        //
        // The 2-D mesh approximates each lamp as an infinite cylinder in
        // z, which is consistent with the lamp spanning the full water
        // depth.
        type            diffuseEmitter;
        nBands          1;
        emissivePower   (208.5);
        value           uniform 0;
    }

    frontAndBack
    {
        type            empty;
    }
}

