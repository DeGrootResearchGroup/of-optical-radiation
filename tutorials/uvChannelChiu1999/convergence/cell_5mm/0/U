FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

// Approach velocity 24 cm/s -- the value the LDV velocity field was
// measured at and the highest of the four points on Chiu Fig. 10. To
// reproduce the rest of the bioassay curve (8, 12, 18 cm/s), edit the
// inlet vector below and rerun. Flow is in +x.
internalField   uniform (0.24 0 0);

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform (0.24 0 0);
    }

    outlet
    {
        type            zeroGradient;
    }

    walls
    {
        type            noSlip;
    }

    lampWall
    {
        type            noSlip;
    }

    frontAndBack
    {
        type            empty;
    }
}

