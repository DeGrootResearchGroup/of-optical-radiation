FoamFile
{
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "p.*"
    {
        solver          GAMG;
        smoother        DIC;
        tolerance       1e-7;
        relTol          0.01;
    }

    "(U|k|epsilon).*"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-6;
        relTol          0.1;
    }

    // Per-ray radiance Ii (one linear system per ray bin per outer
    // iteration of the DOM solve) and G if it is ever solved as a
    // field (radiationDose only reads it).
    "(G|Ii).*"
    {
        solver          PBiCG;
        preconditioner  DILU;
        tolerance       1e-06;
        relTol          0;
    }
}

PIMPLE
{
    nNonOrthogonalCorrectors 0;
    nCorrectors             2;

    // Conservative LTS Courant cap. The wake structure at finer
    // meshes (~1.25 mm) develops a buffer-layer instability at the
    // default maxCo = 1.0 that drives the local |U| to O(10^3) m/s
    // without breaking the global residual normalisation. maxCo = 0.5
    // tames it and the 5 mm / 2.5 mm cases still converge in the
    // endTime = 2000 outer-iteration budget.
    maxCo                   0.5;
    rDeltaTSmoothingCoeff   0.1;
    maxDeltaT               1.0;

    residualControl
    {
        U               1e-3;
        p               5e-3;
        "(k|epsilon)"   1e-3;
    }
}

