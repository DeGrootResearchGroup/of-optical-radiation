# Build artifacts (regenerated by Allmesh / Allrun)
system/blockMeshDict
constant/polyMesh/
0.*
log.*
postProcessing/
VTK/

# Defensive: Allrun-DOM stages a controlDict swap that should clean
# itself up but the bak file would be a poisoned source if it lingered.
system/controlDict.flow.bak

# Override parent tutorials/.gitignore (which ignores all */0/) -- the
# 0/ directory here holds boundary conditions and initial fields,
# not regenerated content.
!0/
!0/*
