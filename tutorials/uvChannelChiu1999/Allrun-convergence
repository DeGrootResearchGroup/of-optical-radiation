#!/bin/sh
cd "${0%/*}" || exit 1
set -e

. "$WM_PROJECT_DIR/bin/tools/RunFunctions"

# Run the Chiu case at three bulk cell sizes, each in its own
# nested subcase under convergence/cell_<size>mm/. Each subcase is a
# self-contained OpenFOAM case (0/, constant/, system/, Allmesh,
# Allrun-DOM, etc.) that can be opened independently in ParaView or
# re-run on its own without touching the parent case.
#
# Default sweep is 5.0 -> 2.5 -> 1.25 mm (factor-of-2 refinement, 4x
# cells per step in 2-D); override the list via CONV_CELL_SIZES.
#
# Set CHIU_NPROC > 1 (recommended for 2.5 mm and finer) to run flow
# and DOM in parallel; the dose tracker stays serial.
#
# After the sweep, run `python3 plot_results.py` from the parent case
# to overlay the dose distributions in postProcessing/figures/.

CONV_CELL_SIZES="${CONV_CELL_SIZES:-0.005 0.0025 0.00125}"
PARENT_DIR=$(pwd)
ROOT="convergence"

mkdir -p "$ROOT"

# Files we copy from the parent template into each new subcase.
# blockMeshDict is intentionally NOT copied: each subcase regenerates
# it via make_mesh.py with its own CHIU_TARGET_CELL_SIZE.
TEMPLATE_DIRS="0 constant system"
TEMPLATE_FILES="Allmesh Allrun-DOM Allclean make_mesh.py validate"

for SIZE in $CONV_CELL_SIZES; do
    SIZE_MM=$(awk "BEGIN { printf \"%g\", $SIZE * 1000 }")
    SUBCASE="$ROOT/cell_${SIZE_MM}mm"
    echo
    echo "=================================================================="
    echo " mesh convergence sweep: cell size $SIZE_MM mm  ($SIZE m)"
    echo " subcase: $SUBCASE"
    echo "=================================================================="

    if [ ! -d "$SUBCASE" ]; then
        echo "Allrun-convergence: creating $SUBCASE from parent template..."
        mkdir -p "$SUBCASE"
        for d in $TEMPLATE_DIRS; do
            cp -r "$d" "$SUBCASE/"
        done
        for f in $TEMPLATE_FILES; do
            cp "$f" "$SUBCASE/"
        done
        # ParaView marker so the subcase opens directly.
        touch "$SUBCASE/out.foam"
        # Drop the generated blockMeshDict (parent's mesh may be a
        # different cell size). Allrun-DOM will regenerate it.
        rm -f "$SUBCASE/system/blockMeshDict"

        # Bake the subcase's cell size into its make_mesh.py default
        # so the subcase is self-contained: a later ./Allrun-DOM
        # inside the subcase doesn't depend on CHIU_TARGET_CELL_SIZE
        # being set in the parent shell.
        sed -i.bak "s|CHIU_TARGET_CELL_SIZE', '0\\.0025'|CHIU_TARGET_CELL_SIZE', '$SIZE'|" \
            "$SUBCASE/make_mesh.py"
        rm -f "$SUBCASE/make_mesh.py.bak"
    fi

    cd "$SUBCASE"
    # Pass CHIU_TARGET_CELL_SIZE explicitly too as belt-and-suspenders
    # (the subcase's make_mesh.py defaults to the right value, but
    # if a user has already exported CHIU_TARGET_CELL_SIZE in their
    # shell we want this sweep to use $SIZE, not their override).
    CHIU_TARGET_CELL_SIZE=$SIZE ./Allrun-DOM
    cd "$PARENT_DIR"

    echo
    echo "Allrun-convergence: $SUBCASE complete"
done

echo
echo "Sweep complete. Each subcase under $ROOT/ holds its own"
echo "0/<time>/, postProcessing/, log.*, etc. Run"
echo "  python3 plot_results.py"
echo "to overlay the three dose distributions in"
echo "  postProcessing/figures/05_convergence_dose.png ."
