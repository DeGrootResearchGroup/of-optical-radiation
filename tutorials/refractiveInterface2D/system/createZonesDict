// Cells with x > 0.5 form zone "mediumB"; the rest become the default
// region "mediumA" via the splitMeshRegions -defaultRegionName flag.
mediumB
{
    type        box;
    zoneType    cell;
    box         (0.5 -1 -1) (1.1 1 1);
}

