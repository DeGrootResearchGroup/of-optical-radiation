#!/bin/sh
cd "${0%/*}" || exit 1

. "$WM_PROJECT_DIR/bin/tools/RunFunctions"

# Clean prior state so runApplication does not skip on stale log.<app>.
./Allclean > /dev/null 2>&1 || true

# Build mesh if not already present
if [ ! -d constant/polyMesh ]; then
    ./Allmesh
fi

# Run the steady RANS flow solve, then chain into the radiationDose
# post-process. Both halves were previously separate scripts; chaining
# them so RUN_LONG_TUTORIALS=1 produces a runnable end-to-end result.
runApplication foamRun

./Allrun-postProcess
