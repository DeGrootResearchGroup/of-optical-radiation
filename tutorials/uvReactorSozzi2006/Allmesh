#!/bin/sh
cd "${0%/*}" || exit 1
set -e

. "$WM_PROJECT_DIR/bin/tools/RunFunctions"

# Regenerate STL geometry if missing
if [ ! -f constant/triSurface/bodyWall.stl ]; then
    python3 make_geometry.py
fi

runApplication blockMesh
runApplication surfaceFeatures
runApplication snappyHexMesh -overwrite
# snappyHexMesh leaves the cells poorly ordered for the linear solvers
# (matrix bandwidth ~1.6M on this mesh); renumbering brings it to ~16k.
runApplication renumberMesh -noFields
runApplication checkMesh
