FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      opticalRadiationProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

opticalRadiation        on;
radiationModel   DOM;

DOMCoeffs
{
    nPhi          5;
    nTheta        5;
    convergence   1e-5;
    maxIter       100;
    nBand         4;
    nPixelPhi     3;
    nPixelTheta   3;

    phaseFunctionModel HenyeyGreensteinModel;
    HenyeyGreensteinModelCoeffs
    {
        subAngleNum     4;
        asymmetryFactor (0.98 0.98 0.98 0.99);
        inScatter       true;
    }
}

// Constant-coefficient extinction. The legacy test01 case used
// wideBandVariableExtinction with two absorbing species (X1, X2) and two
// scattering species (S1, S2) at uniform concentration 0.5 with specific
// coefficients of 0.1 m^2/kg per band. The resulting total coefficients
// are A = 0.1 m^-1 and S = 0.1 m^-1 per band. We use those values here
// so the tutorial runs standalone with opticalRadiationFoam. (Variable extinction
// is intended for use inside a coupled solver that supplies the species
// fields; running it standalone would require extending
// createOpticalRadiationFields.H to load X1/X2/S1/S2.)
extinctionModel wideBandConstantExtinction;
wideBandConstantExtinctionCoeffs
{
    nBands           4;
    absorption       true;
    absorptionCoeff  (0.1 0.1 0.1 0.1);
    scattering       true;
    scatteringCoeff  (0.1 0.1 0.1 0.1);
}

