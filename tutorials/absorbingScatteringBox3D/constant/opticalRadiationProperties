FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      opticalRadiationProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

opticalRadiation        on;
radiationModel   DOM;

DOMCoeffs
{
    nPhi          5;
    nTheta        5;
    convergence   1e-5;
    maxIter       100;
    nBand         4;
    nPixelPhi     3;
    nPixelTheta   3;

    phaseFunctionModel HenyeyGreensteinModel;
    HenyeyGreensteinModelCoeffs
    {
        subAngleNum     4;
        asymmetryFactor (0.98 0.98 0.98 0.99);
        inScatter       true;
    }
}

// Constant-coefficient extinction with kappa = 0.1 m^-1 and
// sigma_s = 0.1 m^-1 per band. The companion variableExtinctionBox3D
// tutorial drives the same net coefficients from species fields via
// wideBandVariableExtinction.
extinctionModel constant;
constantCoeffs
{
    nBands           4;
    absorption       true;
    absorptionCoeff  (0.1 0.1 0.1 0.1);
    scattering       true;
    scatteringCoeff  (0.1 0.1 0.1 0.1);
}

