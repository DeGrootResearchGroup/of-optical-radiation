FoamFile
{
    format      ascii;
    class       volScalarField;
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// omega = epsilon / (Cmu k), from the inlet's k = 0.4555 m^2/s^2 and
// epsilon = Cmu^0.75 k^1.5 / L_t = 37.83 m^2/s^3 (L_t = 0.07 D_inlet):
//   omega = 37.83 / (0.09 * 0.4555) = 922.8 1/s
dimensions      [0 0 -1 0 0 0 0];

internalField   uniform 922.8;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 922.8;
    }

    outlet
    {
        type            zeroGradient;
    }

    bodyWall
    {
        type            omegaWallFunction;
        value           uniform 922.8;
    }

    lampWall
    {
        type            omegaWallFunction;
        value           uniform 922.8;
    }
}

