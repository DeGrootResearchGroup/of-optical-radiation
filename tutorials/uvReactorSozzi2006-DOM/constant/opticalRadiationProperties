FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      opticalRadiationProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Single-band low-pressure mercury arc at 254 nm. The constant
// absorption coefficient matches the analytical Sozzi formula
// sigmaW = 35.67 1/m (70 %/cm UV transmittance in clean water).
// Scattering is neglected (water in this case is essentially
// non-scattering at 254 nm with no particulates).

opticalRadiation        on;
radiationModel          DOM;

DOMCoeffs
{
    // The polar angle theta in [0, pi] (the whole sphere, not one
    // hemisphere) is divided into nTheta bins of pi/nTheta, and the
    // azimuth phi in [0, 2 pi] into 2*nPhi bins of pi/nPhi, giving
    // 2*nPhi*nTheta directions. The bins are square in angle only when
    // nPhi = nTheta: 6 x 6 gives 72 directions, matching Fluent's 3 x 3
    // theta x phi divisions per octant (12 x 12, 288, matches 6 x 6).
    nPhi          6;
    nTheta        6;
    convergence   1e-5;
    maxIter       100;
    nBand         1;
    nPixelPhi     1;
    nPixelTheta   1;
}

extinctionModel constant;
constantCoeffs
{
    nBands           1;
    absorption       true;
    absorptionCoeff  (35.67);   // matches setFluenceRate's sigmaW default
    scattering       false;
    scatteringCoeff  (0);
}

