FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      momentumTransport;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

simulationType RAS;

RAS
{
    // k-omega SST. Sozzi & Taghipour (2006) used realizable k-epsilon with
    // wall functions. On a mesh resolved to the lamp wall (y+ ~ 1),
    // realizable k-epsilon would not settle near the lamp, where the
    // inlet jet runs back along the sleeve; SST converges there. Its
    // wall conditions switch to the log law wherever y+ is above ~11,
    // so the same model serves this tutorial's coarser near-wall cells.
    model           kOmegaSST;

    turbulence      on;

    viscosityModel  Newtonian;
}

