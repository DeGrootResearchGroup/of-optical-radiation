FoamFile
{
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "p.*"
    {
        solver          GAMG;
        smoother        DIC;
        tolerance       1e-7;
        relTol          0.01;
        // The default coarsest level (10 cells per rank) leaves GAMG
        // stalling at its 1000-iteration cap on a mesh resolved to the
        // walls; 1000 cells cut one outer iteration's pressure solves
        // from 2855 to 294 cycles there (8 ranks).
        nCellsInCoarsestLevel 1000;
    }

    "(U|k|omega).*"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-6;
        relTol          0.1;
    }

    // Solve k every iteration: near-wall cells where k collapses to
    // ~1e-16 can swamp its normalised residual below an absolute
    // tolerance, and k then stops being solved.
    "k.*"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-14;
        relTol          0.1;
    }

    // Per-ray radiance Ii (one linear system per ray bin per outer
    // iteration of the DOM solve) and G if it is ever solved as a
    // field (radiationDose only reads it).
    "(G|Ii).*"
    {
        solver          PBiCG;
        preconditioner  DILU;
        tolerance       1e-06;
        relTol          0;
    }
}

PIMPLE
{
    nNonOrthogonalCorrectors 2;
    nCorrectors             2;

    // LTS: clip per-cell pseudo-time step at maxCo. Smaller maxCo gives
    // a slower-but-more-stable march to steady state; 1.0 is the
    // pitzDailyLTS default and is conservative enough for strong jets.
    maxCo                   1.0;
    rDeltaTSmoothingCoeff   0.1;
    maxDeltaT               1.0;

    // Stop when all listed fields have initial residuals below their
    // tolerance for an entire outer iteration. Note: OpenFOAM's
    // "Initial residual" is normalised by the initial residual of the
    // outer iteration, not by an integral mass flux as in Fluent, so
    // these thresholds aren't directly comparable to Fluent's 1e-5.
    // The pressure-drop monitor in controlDict.functions provides an
    // independent integral check on convergence.
    //
    // The pressure drop is NOT a sufficient check for the dose: it is
    // set by the pipe and annulus losses and settles (to ~0.3%) long
    // before the recirculation and turbulence near the lamp do, and the
    // dose tracker's random walk reads k and omega directly. Measured
    // with realizable k-epsilon (before the move to SST)
    // on this mesh (1.64M cells, 8 ranks), the mean dose rose 9% between
    // iterations 514 and 750 while the pressure drop moved 0.35%, and
    // settled to within 0.5% by ~1250. So the thresholds are set where
    // the dose has settled: they are first met at iteration ~1290, with
    // k the last to cross. The residuals level off there (U near 3.5e-4,
    // p near 8.5e-4, epsilon near 6e-5, k still falling slowly through
    // 1e-4), so much tighter values would never be met and the run
    // would stop on endTime instead.
    residualControl
    {
        U               5e-4;
        p               1e-3;
        "(k|omega)"     1e-4;
    }
}

