FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      I;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 0 -3 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    minX
    {
        // Equivalent of the legacy syntax `irradiation 50; bandDist (0.4 0.3 0.2 0.1)`.
        // The legacy formula was L_w = I0 * b_i / (2 pi); the new formula is
        // L_w = E_i / pi (correct Lambertian), so E_i = I0 * b_i / 2.
        type            diffuseEmitter;
        nBands          4;
        emissivePower   (10 7.5 5 2.5);
        value           uniform 0;
    }

    "(maxX|minY|maxY|minZ|maxZ)"
    {
        // Black absorbing walls (R = 0).
        type            reflective;
        diffuseFraction 0;
        reflectionCoef  0;
        refValue        uniform 0;
        refGradient     uniform 0;
        valueFraction   uniform 1;
        value           uniform 0;
    }
}

