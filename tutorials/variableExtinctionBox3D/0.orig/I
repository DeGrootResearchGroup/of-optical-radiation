FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      I;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 0 -3 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    minX
    {
        type            diffuseEmitter;
        nBands          4;
        emissivePower   (10 7.5 5 2.5);
        value           uniform 0;
    }

    "(maxX|minY|maxY|minZ|maxZ)"
    {
        // Black absorbing walls (R = 0).
        type            reflective;
        diffuseFraction 0;
        reflectionCoef  0;
        refValue        uniform 0;
        refGradient     uniform 0;
        valueFraction   uniform 1;
        value           uniform 0;
    }
}

