FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      I;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 0 -3 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    radSource
    {
        // Diffuse Lambertian wall: radiance = emissivePower / pi.
        // Total emitted flux per band = emissivePower (W/m^2).
        type            diffuseEmitter;
        nBands          2;
        emissivePower   (5 5);
        value           uniform 0;
    }
    radOut
    {
        // Black absorber: R = 0, so refValue stays at 0 and outgoing
        // radiance from this wall is forced to zero (perfect sink).
        type            reflectiveSurface;
        diffuseFraction 0;
        reflectionCoef  0;
        refValue        uniform 0;
        refGradient     uniform 0;
        valueFraction   uniform 1;
        value           uniform 0;
    }
    sides
    {
        type            reflectiveSurface;
        diffuseFraction 0;
        reflectionCoef  0;
        refValue        uniform 0;
        refGradient     uniform 0;
        valueFraction   uniform 1;
        value           uniform 0;
    }
    frontAndBack
    {
        type            empty;
    }
}

