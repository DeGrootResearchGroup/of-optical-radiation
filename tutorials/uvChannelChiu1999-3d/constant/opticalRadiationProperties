FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      opticalRadiationProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Single-band 254 nm UV from low-pressure mercury arc lamps. Chiu et al.
// 1999 used a point-source-summation (PSS) intensity model for the same
// physics; we replace PSS with a true DOM solve of the RTE on the
// channel mesh. Absorption coefficient is 43 1/m for the pilot system's
// water (65 % transmittance per cm at 254 nm; alpha_w = 0.43 1/cm).
// Scattering is neglected for clean treated effluent at 254 nm.
//
// Angular grid: 2*nPhi azimuthal x nTheta polar bins = 256 ray directions.
// nTheta = nPhi/2, the same azimuthal:polar ratio as uvReactorSozzi2006-DOM.
// (nTheta must be 1 only for 2-D meshes; the 2-D parent case uses 1.)

opticalRadiation        on;
radiationModel          DOM;

DOMCoeffs
{
    nPhi          16;    // 2*nPhi azimuthal bins
    nTheta        8;     // polar bins; 3-D
    convergence   1e-5;
    maxIter       100;
    nBand         1;
    nPixelPhi     1;
    nPixelTheta   1;
}

extinctionModel constant;
constantCoeffs
{
    nBands           1;
    absorption       true;
    absorptionCoeff  (43.0);
    scattering       false;
    scatteringCoeff  (0);
}

