FoamFile
{
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "p.*"
    {
        solver          GAMG;
        smoother        DIC;
        tolerance       1e-7;
        relTol          0.01;
    }

    "(U|k|epsilon).*"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-6;
        relTol          0.1;
    }

    // Per-ray radiance Ii (one linear system per ray bin per outer
    // iteration of the DOM solve) and G if it is ever solved as a
    // field (radiationDose only reads it).
    "(G|Ii).*"
    {
        solver          PBiCG;
        preconditioner  DILU;
        tolerance       1e-06;
        relTol          0;
    }
}

PIMPLE
{
    // 2 non-orthogonal correctors so the pressure solve compensates
    // for the wedge cells around each lamp (cylinder-projected
    // corners produce ~45 deg face skewness). 0 correctors is enough
    // for the 5 mm and 2.5 mm meshes but the 1.25 mm wake structure
    // amplifies the orthogonality error and the flow blows up
    // without this.
    nNonOrthogonalCorrectors 2;
    nCorrectors             2;

    // 3-D RANS gets cleaner convergence than 2-D (spanwise
    // dissipation pathways the 2-D simulation doesn't have), so start
    // at maxCo = 1.0; tighten only if residuals plateau or local U
    // blows up.
    maxCo                   1.0;
    rDeltaTSmoothingCoeff   0.1;
    maxDeltaT               1.0;

    residualControl
    {
        U               1e-3;
        p               5e-3;
        "(k|epsilon)"   1e-3;
    }
}

