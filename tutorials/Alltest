#!/bin/sh
#
# Run every tutorial case and check the result.
#
# - Each case's Allrun is invoked.
# - If a case has a `validate` script it is executed; non-zero exit
#   means failure.
# - The cross-case check at the end compares G fields between
#   absorbingScatteringBox3D and variableExtinctionBox3D, which are
#   mathematically equivalent and should produce identical results.
#
# Exit code: 0 if all checks pass, 1 otherwise.

set -u
cd "${0%/*}" || exit 1

if [ -z "${WM_PROJECT_DIR:-}" ]; then
    echo "Alltest: WM_PROJECT_DIR not set; source the OpenFOAM environment" >&2
    exit 1
fi

overall=0

# 1) Run every case.
for case_dir in */ ; do
    case_name="${case_dir%/}"
    if [ -x "$case_name/Allrun" ]; then
        echo "==> running $case_name"
        if ! ( cd "$case_name" && ./Allrun ) > /dev/null 2>&1; then
            echo "    FAIL (Allrun returned non-zero)"
            overall=1
            continue
        fi
        echo "    ok"
    fi
done

# 2) Per-case validation scripts.
for case_dir in */ ; do
    case_name="${case_dir%/}"
    if [ -x "$case_name/validate" ]; then
        echo "==> validating $case_name"
        if ( cd "$case_name" && ./validate ); then
            echo "    PASS"
        else
            echo "    FAIL"
            overall=1
        fi
    fi
done

# 3) Cross-case matches.
#    Each pair below should produce bit-for-bit identical G (different
#    code paths solving the same radiation problem).
cross_case_check() {
    label="$1"
    a="$2"
    b="$3"
    if [ ! -f "$a" ] || [ ! -f "$b" ]; then
        echo "==> cross-case match: $label: skipping (one or both runs missing)"
        return 0
    fi
    echo "==> cross-case match: $label"
    if A="$a" B="$b" python3 - <<'PY'
import os, re, sys

def read_G(path):
    with open(path) as f:
        txt = f.read()
    m = re.search(
        r"internalField\s+nonuniform\s+List<scalar>\s*\n(\d+)\n\(([^)]+)\)",
        txt, re.S,
    )
    if not m:
        sys.exit(f"could not parse {path}")
    return list(map(float, m.group(2).split()))

a = read_G(os.environ["A"])
b = read_G(os.environ["B"])
if len(a) != len(b):
    sys.exit(f"size mismatch: {len(a)} vs {len(b)}")

TOL = 1e-9
max_abs = max(abs(av - bv) for av, bv in zip(a, b))
scale = max(max(abs(av) for av in a), 1e-12)
max_rel = max_abs / scale
print(f"max |dG| = {max_abs:.3e}, max rel = {max_rel:.3e}, tol = {TOL:.0e}")
sys.exit(0 if max_rel <= TOL else 1)
PY
    then
        echo "    PASS"
    else
        echo "    FAIL"
        overall=1
    fi
}

# absorbingScatteringBox3D vs variableExtinctionBox3D: same physics
# (constant kappa/sigma_s) routed through two different extinction-model
# paths.
cross_case_check \
    "absorbingScatteringBox3D vs variableExtinctionBox3D" \
    "absorbingScatteringBox3D/1/G" \
    "variableExtinctionBox3D/1/G"

# fvModelChannel2D vs diffuseSlab2D: same radiation problem solved
# either by opticalRadiationFoam directly (slab) or by foamRun
# invoking the radiation through the opticalRadiation fvModel
# (channel). Proves end-to-end fvModel integration.
cross_case_check \
    "fvModelChannel2D vs diffuseSlab2D" \
    "fvModelChannel2D/0.5/G" \
    "diffuseSlab2D/1/G"

if [ "$overall" -eq 0 ]; then
    echo
    echo "Alltest: ALL PASS"
else
    echo
    echo "Alltest: FAILURES"
fi
exit "$overall"
