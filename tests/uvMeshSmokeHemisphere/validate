#!/usr/bin/env python3
"""Validate the uvMesh hemispherical-cap smoke test mesh.

Pipeline regression for the cubed-sphere annular hemisphere path.
Checks the same things the flat-flat smoke does (patches, NCC, dual
mesh), plus hemisphere-specific patch names (`lamp0_tip_B` instead
of `lamp0_endcap_B`) and the combined cylinder+hemisphere seam.

Mesh quality: the case uses `ReactorBody.bulk_cells="tet"` to skip
polyDualMesh on the bulk -- polyDualMesh's dualization of obtuse tets
along the capsule's cylinder-sphere fusion seam produces ~0.06 % of
cells with bad face pyramids and max skewness ~8.7. The tet bulk
avoids the dualization entirely; the validate therefore requires
`Mesh OK` outright (no per-metric leniency).
"""
from __future__ import annotations

import os
import re
import sys


HERE = os.path.dirname(os.path.abspath(__file__))


def read(path):
    with open(path, "r") as fh:
        return fh.read()


def fail(msg):
    print(f"VALIDATE FAIL: {msg}", file=sys.stderr)
    sys.exit(1)


def passed(msg):
    print(f"  ok  {msg}")


# 1. checkMesh must report "Mesh OK". With bulk_cells="tet" the
#    polyDualMesh artifact is avoided entirely, so any failure here
#    is a real topology bug.
log = read(os.path.join(HERE, "log.checkMesh"))
if not re.search(r"^Mesh OK\.?\s*$", log, re.MULTILINE):
    fail("checkMesh did not report 'Mesh OK'")
passed("checkMesh reported Mesh OK")

# Sanity-check key quality metrics. "Mesh OK" already accepts these
# below OpenFOAM's failure thresholds (non-orth < 90 deg, skew < 4);
# we re-assert them as regression guards but loose enough not to be
# tighter than checkMesh itself. The cubed-sphere annular shell has
# unavoidably high non-orth near the polar singularity (87-89 deg
# observed) -- that's the cost of the topology choice, not a fix-it
# bug.
m_non_orth = re.search(r"Mesh non-orthogonality Max:\s*([\d.eE+-]+)", log)
non_orth = float(m_non_orth.group(1)) if m_non_orth else None
if non_orth is None or non_orth >= 90.0:
    fail(f"checkMesh max non-orthogonality {non_orth} >= 90 deg")
passed(f"max non-orthogonality {non_orth:.2f} deg")

m_skew = re.search(r"Max skewness\s*=\s*([\d.eE+-]+)", log)
skew = float(m_skew.group(1)) if m_skew else None
if skew is None or skew >= 4.0:
    fail(f"checkMesh max skewness {skew} >= 4.0")
passed(f"max skewness {skew:.2f}")

# 2. Expected patches present.
boundary = read(os.path.join(HERE, "constant", "polyMesh", "boundary"))

# Note vs the flat-flat smoke: `lamp0_endcap_B` is replaced by
# `lamp0_tip_B`, the rest are the same set.
expected_patches = {
    # bulk patches
    "bulkWall":           "patch",
    "endcap_lo":          "patch",
    "endcap_hi":          "patch",
    "reactor_seam_lamp0": "patch",
    # annulus patches (cylindrical + hemispherical)
    "lamp0_wall":         "wall",
    "lamp0_seam":         "patch",
    "lamp0_endcap_A":     "wall",
    "lamp0_tip_B":        "wall",
    # NCC pair
    "nonConformalCyclic_on_reactor_seam_lamp0": "nonConformalCyclic",
    "nonConformalCyclic_on_lamp0_seam":         "nonConformalCyclic",
    "nonConformalError_on_reactor_seam_lamp0":  "nonConformalError",
    "nonConformalError_on_lamp0_seam":          "nonConformalError",
}

for patch_name, expected_type in expected_patches.items():
    pat = re.compile(
        rf"^\s*{re.escape(patch_name)}\s*\{{[^}}]*?\btype\s+(\S+?);",
        re.MULTILINE | re.DOTALL,
    )
    m = pat.search(boundary)
    if m is None:
        fail(f"patch '{patch_name}' not found in constant/polyMesh/boundary")
    if m.group(1) != expected_type:
        fail(
            f"patch '{patch_name}': expected type '{expected_type}', "
            f"got '{m.group(1)}'"
        )
    passed(f"patch {patch_name} present with type {expected_type}")

# 2a. Hemispherical-cap patch face count sanity. lamp0_tip_B should
# have approximately n_polar^2 cells per block * 5 blocks =
# n_azimuth_per_quadrant^2 * 5 = 10^2 * 5 = 500 faces.
m_tip = re.search(
    r"^\s*lamp0_tip_B\s*\{[^}]*?nFaces\s+(\d+);", boundary,
    re.MULTILINE | re.DOTALL,
)
if m_tip is None:
    fail("could not parse face count for lamp0_tip_B")
n_tip = int(m_tip.group(1))
if n_tip < 100 or n_tip > 5000:
    fail(f"lamp0_tip_B has {n_tip} faces; expected ~500 (cubed-sphere 5x10x10)")
passed(f"lamp0_tip_B has {n_tip} faces (cubed-sphere 5x10x10 ~= 500)")

# 2b. Combined seam includes both cylindrical and hemispherical parts.
# The flat-flat smoke had 800-face lamp0_seam (cylinder only); the
# hemisphere case has +500 from the cap, so ~1300 total.
m_seam = re.search(
    r"^\s*lamp0_seam\s*\{[^}]*?nFaces\s+(\d+);", boundary,
    re.MULTILINE | re.DOTALL,
)
if m_seam is None:
    fail("could not parse face count for lamp0_seam")
n_seam = int(m_seam.group(1))
if n_seam < 1000:
    fail(
        f"lamp0_seam has only {n_seam} faces; expected > 1000 "
        f"(cylinder + hemisphere). Hemisphere may not have been merged."
    )
passed(f"lamp0_seam has {n_seam} faces (cylinder + hemisphere combined)")

# 3. NCC fuse worked.
ncc_log = read(os.path.join(HERE, "log.createNonConformalCouples"))
m = re.search(r"(\d+)\s+couplings calculated", ncc_log)
if m is None:
    fail("createNonConformalCouples log does not report couplings count")
n_couplings = int(m.group(1))
if n_couplings < 100:
    fail(f"createNonConformalCouples produced only {n_couplings} couplings (<100)")
passed(f"createNonConformalCouples produced {n_couplings} face couplings")

for label in ("Source", "Target"):
    m = re.search(
        rf"{label} min/average/max coverage = [\d.eE+-]+/([\d.eE+-]+)/[\d.eE+-]+",
        ncc_log,
    )
    if m is None:
        fail(f"createNonConformalCouples log missing {label} coverage line")
    avg_cov = float(m.group(1))
    if avg_cov < 0.9:
        fail(f"createNonConformalCouples {label} avg coverage {avg_cov:.3f} < 0.9")
    passed(f"createNonConformalCouples {label} avg coverage {avg_cov:.4f}")

# 4. Bulk is tets, not polyhedra (we used bulk_cells="tet" in
#    mesh.py to sidestep the polyDualMesh capsule-junction artifact).
#    Confirm by inspecting checkMesh's element-type breakdown.
m_tets = re.search(r"^\s*tetrahedra:\s+(\d+)", log, re.MULTILINE)
m_polys = re.search(r"^\s*polyhedra:\s+(\d+)", log, re.MULTILINE)
n_tets = int(m_tets.group(1)) if m_tets else 0
n_polys = int(m_polys.group(1)) if m_polys else 0
if n_tets == 0:
    fail("bulk has no tetrahedra; expected gmsh tet bulk under bulk_cells='tet'")
if n_polys != 0:
    fail(
        f"bulk has {n_polys} polyhedra; expected zero under bulk_cells='tet' "
        f"(polyDualMesh must NOT have run)"
    )
passed(f"bulk is {n_tets} tetrahedra, 0 polyhedra (polyDualMesh skipped)")

# Confirm polyDualMesh log is absent for the bulk (i.e. Allrun.mesh
# really skipped it).
if os.path.exists(
    os.path.join(HERE, "_uvMesh", "bulk_body", "log.polyDualMesh")
):
    fail(
        "log.polyDualMesh exists in bulk_body/ but bulk_cells='tet' should "
        "have skipped that step"
    )
passed("polyDualMesh was not run on the bulk (as configured)")

print()
print("uvMeshSmokeHemisphere: all checks passed.")
