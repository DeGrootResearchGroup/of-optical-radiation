FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "1";
    object      SLambda_2;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 -1 0 0 0 0 0];

internalField   uniform 0.1;

boundaryField
{
    minX
    {
        type            calculated;
        value           uniform 0.1;
    }
    maxX
    {
        type            calculated;
        value           uniform 0.1;
    }
    minY
    {
        type            calculated;
        value           uniform 0.1;
    }
    maxY
    {
        type            calculated;
        value           uniform 0.1;
    }
    minZ
    {
        type            calculated;
        value           uniform 0.1;
    }
    maxZ
    {
        type            calculated;
        value           uniform 0.1;
    }
}


