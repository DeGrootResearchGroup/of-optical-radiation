#!/usr/bin/env python3
"""y-averaged G(x) comparison against diffuseSlab2D.

nonConformalCyclicMatch deliberately uses MISMATCHED y discretisation
across the AMI interface (10 cells on the left block vs 13 on the
right) so the coupling is genuinely non-conformal. The validate script
compares y-averaged G(x) profiles against diffuseSlab2D: with specular
y mirrors at y=0 and y=0.1 the converged DOM problem is 1-D in x, so
G(x) should be very close on both sides regardless of y
discretisation. Tolerance is set looser than the conformal cyclicMatch
case to absorb genuine AMI interpolation error at x=0.5.
"""
import os
import subprocess
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "lib"))
from foam_field import read_internal_scalar_field

HERE = os.path.dirname(os.path.abspath(__file__))
DIFFUSE = os.path.normpath(os.path.join(HERE, "..", "diffuseSlab2D"))
NCC = HERE

# Tolerance: at this geometry the y-uniformity from the specular
# mirrors makes the AMI interpolation across x=0.5 essentially exact
# (the source field is y-uniform on both sides, so any partition-
# of-unity weighted average reproduces it). Observed agreement is
# ~1e-5 relative; tolerance set at 1e-4 for margin.
TOL = 1e-4


def ensure_cell_centres(case_dir):
    if all(os.path.exists(os.path.join(case_dir, "1", f)) for f in ("Ccx", "Ccy", "Ccz")):
        return
    subprocess.run(
        [
            "foamPostProcess",
            "-case", case_dir,
            "-func", "writeCellCentres",
            "-time", "1",
        ],
        check=True,
    )


def y_average_G_by_x(case_dir):
    """Return {x_rounded: mean(G over all cells at this x)}."""
    ensure_cell_centres(case_dir)
    G  = read_internal_scalar_field(os.path.join(case_dir, "1", "G"))
    Cx = read_internal_scalar_field(os.path.join(case_dir, "1", "Ccx"))
    if len(G) != len(Cx):
        sys.exit(f"size mismatch in {case_dir}: G={len(G)} Cx={len(Cx)}")
    sums = {}
    counts = {}
    for x, g in zip(Cx, G):
        key = round(x, 9)
        sums[key] = sums.get(key, 0.0) + g
        counts[key] = counts.get(key, 0) + 1
    return {k: sums[k] / counts[k] for k in sums}


def main():
    a = y_average_G_by_x(DIFFUSE)
    b = y_average_G_by_x(NCC)
    if set(a.keys()) != set(b.keys()):
        only_a = sorted(set(a.keys()) - set(b.keys()))[:5]
        only_b = sorted(set(b.keys()) - set(a.keys()))[:5]
        sys.exit(f"x grids differ; only in A: {only_a}, only in B: {only_b}")

    max_abs = 0.0
    scale = 0.0
    worst_x = None
    for x in sorted(a):
        d = abs(a[x] - b[x])
        if d > max_abs:
            max_abs = d
            worst_x = x
        scale = max(scale, abs(a[x]))
    max_rel = max_abs / max(scale, 1e-12)
    print(f"compared {len(a)} unique x values")
    print(f"max |dG_y_avg| = {max_abs:.3e} at x = {worst_x:.4f}")
    print(f"max rel = {max_rel:.3e}, tol = {TOL:.0e}")
    if max_rel <= TOL:
        print("PASS")
        return 0
    else:
        print("FAIL")
        return 1


if __name__ == "__main__":
    sys.exit(main())
