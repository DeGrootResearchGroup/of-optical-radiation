FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      I;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 0 -3 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    radSource
    {
        type            diffuseEmitter;
        nBands          2;
        emissivePower   ( 5 5 );
        value           uniform 0;
    }
    radOut
    {
        type            reflective;
        diffuseFraction 0;
        reflectionCoef  0;
        refValue        uniform 0;
        refGradient     uniform 0;
        valueFraction   uniform 1;
        value           uniform 0;
    }
    sides
    {
        type            reflective;
        diffuseFraction 0;
        reflectionCoef  1;
        refValue        uniform 0;
        refGradient     uniform 0;
        valueFraction   uniform 1;
        value           uniform 0;
    }
    frontAndBack
    {
        type            empty;
    }
    AMI_L
    {
        type            zeroGradient;
    }
    AMI_R
    {
        type            zeroGradient;
    }
    nonConformalCyclic_on_AMI_L
    {
        type            nonConformalCyclic;
    }
    nonConformalCyclic_on_AMI_R
    {
        type            nonConformalCyclic;
    }
    nonConformalError_on_AMI_L
    {
        type            nonConformalError;
    }
    nonConformalError_on_AMI_R
    {
        type            nonConformalError;
    }
}


