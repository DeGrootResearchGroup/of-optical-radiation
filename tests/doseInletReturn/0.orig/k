/*--------------------------------*- C++ -*----------------------------------*\
  =========                 |
  \\      /  F ield         | radiationDose: a random step back through the inlet
   \\    /   O peration     |
    \\  /    A nd           |
     \\/     M anipulation  |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

// Uniform turbulence, k = 0.25: fluctuations of sqrt(2k/3) ~ 0.41 m/s on
// the 0.5 m/s plug flow, strong enough that many first steps point
// upstream. With epsilon = 0.25 the eddy lifetime is Cl k / epsilon = 0.15 s.
internalField   uniform 0.25;

boundaryField
{
    inlet
    {
        type            zeroGradient;
    }
    outlet
    {
        type            zeroGradient;
    }
    walls
    {
        type            zeroGradient;
    }
}

