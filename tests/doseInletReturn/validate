#!/usr/bin/env python3
"""A particle that steps back through its injection patch reflects off it.

Plug flow at 0.5 m/s through the dose smoke box with a strong discrete
random walk (fluctuations ~0.4 m/s), seeded on the inlet. Many first
steps point upstream and carry the particle straight back to the inlet,
which is neither a wall nor an escape patch. The particle must reflect
off it (the inlet is its injection patch) rather than end there with no
time and no dose.

This checks:

  1. every seeded track escaped through the outlet: none stuck on the
     inlet (or anywhere else);
  2. every track's dose equals its residence time in mJ/cm^2
     (G = 10 W/m^2 uniform, so D = G t 0.1 = t).
"""

import csv
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "lib"))
from foam_field import find_latest_time, parse_summary

HERE = os.path.dirname(os.path.abspath(__file__))

fails = []
latest = find_latest_time(os.path.join(HERE, "postProcessing", "radiationDose"))
if latest is None:
    print("FAIL: missing radiationDose output")
    sys.exit(1)

s = parse_summary(os.path.join(latest, "summary.dat"))
with open(os.path.join(latest, "doseDistribution.csv")) as f:
    rows = list(csv.reader(line for line in f if not line.startswith("#")))

print(f"  {s['escaped']:.0f} of {s['totalSeeded']:.0f} tracks escaped "
      f"(stuck {s['stuck']:.0f}, timed out {s['timedOut']:.0f})")
if s["totalSeeded"] < 200 or s["escaped"] != s["totalSeeded"]:
    fails.append(f"{s['escaped']:.0f} of {s['totalSeeded']:.0f} tracks escaped")
for r in rows:
    if r[1] != "escaped":
        fails.append(f"track {r[0]} {r[1]} at ({r[4]}, {r[5]}, {r[6]}) after {r[2]} s")
        break

worst = max(abs(float(r[3]) - float(r[2])) / float(r[2]) for r in rows if float(r[2]) > 0)
print(f"  worst |D - t|/t = {worst:.2e}")
if worst > 1e-9:
    fails.append(f"dose differs from residence time (worst {worst:.2e})")

if fails:
    for f in fails:
        print("FAIL:", f)
    sys.exit(1)
print("PASS: particles stepping back through the inlet reflect and reach the outlet")
