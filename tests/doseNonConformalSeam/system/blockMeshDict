FoamFile
{
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// A 1 m channel cut in two at x = 0.5 by a seam that Allrun couples
// non-conformally (createNonConformalCouples seamL seamR):
//
//  - Over 0 < y < 0.1 the seam is bowed toward +x (an arc through
//    x = 0.505 at y = 0.05) and the two sides are meshed with different
//    counts across it (8 x 4 cells on the left, 11 x 5 on the right), so
//    each side facets the curve with its own chords and the two surfaces
//    lie up to ~0.08 mm apart.
//
//  - The left side is wider: strips 0.02 m deep below y = 0 and above
//    y = 0.1 end on parts of seamL that face nothing on the right. Those
//    faces are uncovered by the coupling (its nonConformalError faces);
//    to a particle they are a wall.

scale   1;

vertices
(
    // Left, middle block: x from 0 to the seam, 0 < y < 0.1
    (0    0   0)        // 0
    (0.5  0   0)        // 1
    (0.5  0.1 0)        // 2
    (0    0.1 0)        // 3
    (0    0   0.1)      // 4
    (0.5  0   0.1)      // 5
    (0.5  0.1 0.1)      // 6
    (0    0.1 0.1)      // 7
    // Right block: the seam to x = 1 (its own vertices on the seam)
    (0.5  0   0)        // 8
    (1    0   0)        // 9
    (1    0.1 0)        // 10
    (0.5  0.1 0)        // 11
    (0.5  0   0.1)      // 12
    (1    0   0.1)      // 13
    (1    0.1 0.1)      // 14
    (0.5  0.1 0.1)      // 15
    // Left strips, -0.02 < y < 0 and 0.1 < y < 0.12
    (0   -0.02 0)       // 16
    (0.5 -0.02 0)       // 17
    (0   -0.02 0.1)     // 18
    (0.5 -0.02 0.1)     // 19
    (0    0.12 0)       // 20
    (0.5  0.12 0)       // 21
    (0    0.12 0.1)     // 22
    (0.5  0.12 0.1)     // 23
);

blocks
(
    hex (0 1 2 3 4 5 6 7)         (20 8 4)  simpleGrading (1 1 1)
    hex (16 17 1 0 18 19 5 4)     (20 2 4)  simpleGrading (1 1 1)
    hex (3 2 21 20 7 6 23 22)     (20 2 4)  simpleGrading (1 1 1)
    hex (8 9 10 11 12 13 14 15)   (20 11 5) simpleGrading (1 1 1)
);

edges
(
    arc 1 2   (0.505 0.05 0)
    arc 5 6   (0.505 0.05 0.1)
    arc 8 11  (0.505 0.05 0)
    arc 12 15 (0.505 0.05 0.1)
);

boundary
(
    inlet
    {
        type patch;
        faces
        (
            (0 4 7 3)
            (16 18 4 0)
            (3 7 22 20)
        );
    }
    outlet
    {
        type patch;
        faces ((9 10 14 13));
    }
    walls
    {
        type wall;
        faces
        (
            // left: y = -0.02 and y = 0.12, then z = 0 and z = 0.1
            (16 17 19 18)
            (20 22 23 21)
            (0 3 2 1)
            (4 5 6 7)
            (16 0 1 17)
            (18 19 5 4)
            (3 20 21 2)
            (7 6 23 22)
            // right: y = 0 and y = 0.1, then z = 0 and z = 0.1
            (8 12 13 9)
            (11 10 14 15)
            (8 9 10 11)
            (12 15 14 13)
        );
    }
    seamL
    {
        type patch;
        faces
        (
            (1 2 6 5)
            (17 1 5 19)
            (2 21 23 6)
        );
    }
    seamR
    {
        type patch;
        faces ((8 12 15 11));
    }
);

mergePatchPairs ();

