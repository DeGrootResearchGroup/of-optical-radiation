FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      Ugrazing;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

// The deterministic instance's velocity: 0.5 m/s along x and 0.5 m/s
// down into the z = 0 wall. The particles reach the wall and slide along
// it (each outer step's motion into it is reflected), so they meet the
// seam where it ends on the wall, at 45 degrees to it. Neither reflection
// off z = 0 nor crossing the seam changes the x speed, so every track that
// starts at x = 0.2 takes exactly 1.6 s to reach the outlet.
internalField   uniform (0.5 0 -0.5);

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform (0.5 0 -0.5);
    }
    outlet
    {
        type            zeroGradient;
    }
    walls
    {
        type            slip;
    }
    seamL
    {
        type            zeroGradient;
    }
    seamR
    {
        type            zeroGradient;
    }
}

