FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "1/mediumB";
    object      I;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 0 -3 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    radOut
    {
        type            reflective;
        refValue        uniform 0;
        refGradient     uniform 0;
        valueFraction   uniform 1;
        value           uniform 0;
        reflectionCoef   0;
        diffuseFraction   0;
    }
    sides
    {
        type            reflective;
        refValue        uniform 0;
        refGradient     uniform 0;
        valueFraction   uniform 1;
        value           uniform 0;
        reflectionCoef   0;
        diffuseFraction   0;
    }
    frontAndBack
    {
        type            empty;
    }
    mediumB_to_mediumA
    {
        type            radiationCoupled;
        refValue        uniform 0;
        refGradient     uniform 0;
        valueFraction   uniform 1;
        value           uniform 0;
        nBands          1;
        n               1(1.33);
    }
}


