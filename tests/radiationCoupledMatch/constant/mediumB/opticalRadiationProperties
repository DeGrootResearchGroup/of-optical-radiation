FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant/mediumB";
    object      opticalRadiationProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

opticalRadiation on;
radiationModel   DOM;

DOMCoeffs
{
    nPhi          8;
    nTheta        1;
    convergence   1e-6;
    maxIter       100;
    nBand         1;
    nPixelPhi     1;
    nPixelTheta   1;
}

extinctionModel constant;
constantCoeffs
{
    nBands           1;
    absorption       true;
    absorptionCoeff  (0);
    scattering       false;
    scatteringCoeff  (0);
}

