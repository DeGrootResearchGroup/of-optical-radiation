FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0/mediumB";
    object      I;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 0 -3 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    radOut
    {
        // Black absorber at the far end.
        type            reflective;
        diffuseFraction 0;
        reflectionCoef  0;
        refValue        uniform 0;
        refGradient     uniform 0;
        valueFraction   uniform 1;
        value           uniform 0;
    }

    sides
    {
        type            reflective;
        diffuseFraction 0;
        reflectionCoef  0;
        refValue        uniform 0;
        refGradient     uniform 0;
        valueFraction   uniform 1;
        value           uniform 0;
    }

    mediumB_to_mediumA
    {
        // Matches the mediumA side's n exactly so radiationCoupled's
        // construction-time validation accepts the pair.
        type            radiationCoupled;
        nBands          1;
        n               (1.33);
        value           uniform 0;
    }

    frontAndBack
    {
        type            empty;
    }
}

