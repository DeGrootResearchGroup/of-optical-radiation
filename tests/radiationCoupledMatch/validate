#!/usr/bin/env python3
"""Verification of radiationCoupled at a matched-index multi-region interface.

Geometry: 2-D, two-region (mediumA n=1.33, mediumB n=1.33).
Source: collimated beam at theta = 11.25 deg from +x (centre of
        ray-bin 0 in the nPhi=8 angular discretisation; the beam
        radiance lands cleanly in one ray bin).
Both zones transparent (kappa = 0). Mapped patches between regions.

Analytical (matched n -> Fresnel R = 0, n^2 scaling = 1):

    G_A = L_0 * omega_0
    G_B = L_0 * omega_0

i.e. both regions show the same G at lit-region cells -- the
radiance just passes through the interface unchanged. omega_0 =
pi/4 for nPhi=8 in 2-D.

Probes are placed along the discrete-ordinate characteristic from
y_source = 0.10, at x = 0.30 (mediumA) and x = 0.70 (mediumB).
Both points are well inside the lit region and away from the
y-walls.

This is the architectural payoff test for radiationCoupled: at
matched n, it should produce the same G as refractiveCoupled would
have done (the latter does pixelation + Fresnel + n^2 scaling
internally but all of those collapse to no-ops here). The
radiationCoupled BC skips all of that work explicitly and gets the
right answer.
"""

import os
import math
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "lib"))
from foam_field import read_internal_scalar_field

TOLERANCE = 0.05  # 5%


def main():
    L0 = 10.0
    theta = math.radians(11.25)
    omega_0 = math.pi / 4.0

    G_expected = L0 * omega_0  # same on both sides at matched n

    GA = read_internal_scalar_field("1/mediumA/G")
    GB = read_internal_scalar_field("1/mediumB/G")

    nx = 50
    def cell(grid, x, y, x_offset=0.0):
        ix = int((x - x_offset) / 0.01)
        iy = int(y / 0.01)
        return grid[ix + iy*nx]

    tan_a = math.tan(theta)
    xA, yA = 0.30, 0.10 + 0.30 * tan_a
    xB, yB = 0.70, 0.10 + 0.70 * tan_a

    GA_sim = cell(GA, xA, yA)
    GB_sim = cell(GB, xB, yB, x_offset=0.5)

    rA = abs(GA_sim - G_expected) / G_expected
    rB = abs(GB_sim - G_expected) / G_expected
    rAB = abs(GB_sim - GA_sim) / max(GA_sim, 1e-12)

    print(f"theta = 11.25 deg, R = 0 (matched n), omega_0 = pi/4")
    print(f"expected: G_A = G_B = L0 * omega_0 = {G_expected:.4f}")
    print()
    print(f"  mediumA probe ({xA:.3f}, {yA:.3f})  G = {GA_sim:7.4f}  err = {rA:+.2%}")
    print(f"  mediumB probe ({xB:.3f}, {yB:.3f})  G = {GB_sim:7.4f}  err = {rB:+.2%}")
    print(f"  cross-interface |G_B - G_A| / G_A = {rAB:+.2%}")
    print(f"  tolerance = {TOLERANCE:.2%}")

    return 0 if max(rA, rB, rAB) <= TOLERANCE else 1


if __name__ == "__main__":
    sys.exit(main())
