FoamFile
{
    format      ascii;
    class       dictionary;
    object      controlDict;
}

application     postProcess;
startTime       0;
endTime         0;
deltaT          1;
writeControl    timeStep;
writeInterval   1;
purgeWrite      0;
writeFormat     ascii;
writePrecision  8;

// The well-mixed condition: particles spread uniformly through a closed box
// with no mean flow must stay uniform, however the turbulence varies. k rises
// from zero on the wall y = 0 and the eddy lifetime with it (makeFields), so
// the walk's diffusivity K = k tau_e / 3 falls as y^4 towards that wall, as it
// does in a viscous sublayer, and is flat at y = H. The lifetime crosses the
// 5 ms step near y = 17 mm: several eddies per step below it, eddies spanning
// many steps above. cflMax 2 keeps the CFL bound from shortening any step, so
// the vertices recorded every 100 steps are snapshots at common times. The
// same walk runs twice from the same seed: once corrected (wellMixed, the
// default) and once uncorrected, and the random displacement model with the
// same K once. `validate` checks the corrected walk and the random
// displacement model stay uniform and the uncorrected walk piles particles up
// on the low-k side.

drw
{
    type        discreteRandomWalk;
    k           k;
    omega       omega;
    Cmu         0.09;
    Cl          0.15;
}

wellMixedDrw
{
    type            radiationDose;
    libs            ("libradiationDose.so");
    U               U;
    fluenceRate     G;
    seed            11;
    seeding
    {
        type        pointInjection;
        nParticles  5000;
        region      { type box; centre (0.02 0.05 0.01); size (0.04 0.1 0.02); }
    }
    termination     { escapePatches (); maxTime 10; maxDose 0; wallReflection true; }
    integration     { dtMax 0.005; cflMax 2; }
    // Only the seed and the end of each track: validate reads both.
    output          { kInact (0.1); writeVtk true; trajectoryStride 100; }
}

functions
{
    wellMixed
    {
        $wellMixedDrw;
        dispersion  { $drw; wellMixed true; }
    }
    uncorrected
    {
        $wellMixedDrw;
        dispersion  { $drw; wellMixed false; }
    }
    randomDisplacement
    {
        $wellMixedDrw;
        dispersion  { $drw; type randomDisplacement; }
    }
    // The Langevin model at its defaults: steps of 0.02 max(T_L, 10 ms). T_L
    // runs from 50 us on the low-k wall to 25 ms at y = H, so the step is at
    // its floor (0.2 ms) below y ~ 39 mm, where it is up to 4 T_L long and the
    // first-order drift correction carries the well-mixed condition, and a
    // fraction of T_L above. It is judged at its end points (one snapshot at
    // maxTime), so it is given four times the particles of the others.
    langevin
    {
        $wellMixedDrw;
        seeding
        {
            type        pointInjection;
            nParticles  20000;
            region      { type box; centre (0.02 0.05 0.01); size (0.04 0.1 0.02); }
        }
        dispersion  { $drw; type langevin; }
    }
}

