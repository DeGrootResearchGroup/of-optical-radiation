#!/usr/bin/env python3
"""Smoke-test radiationDose: dose accumulation and VTK writer.

The case is a 1 m x 0.1 m x 0.1 m box with uniform U = (0.5, 0, 0)
m/s, slip walls (so the cell-vertex-interpolated velocity stays
equal to the bulk value everywhere), and uniform G = 10 W/m^2.
Plug flow with constant G means *every* escaped particle sees the
same residence time L/V_x = 1/0.5 = 2 s and the same accumulated
dose G * t * 0.1 = 2.0 mJ/cm^2. The dose distribution is
deterministic to floating-point precision.

This script checks:

  1. summary.dat: every seeded particle escapes (no time-outs, no
     stuck), the mean escape dose is 2.0 mJ/cm^2 within 1 part in
     1000, and the spread is at floating-point noise level.
  2. trajectories.vtk exists, parses as legacy VTK ASCII PolyData,
     and its POINT_DATA / CELL_DATA section counts agree with the
     POINTS / LINES counts respectively.
"""

import os
import re
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "lib"))
from foam_field import find_latest_time, parse_summary


def find_latest(name, func="radiationDose"):
    """Path of `name` inside the latest postProcessing/<func>/<time>/ dir."""
    base = os.path.join(
        os.path.dirname(os.path.abspath(__file__)),
        "postProcessing", func,
    )
    latest = find_latest_time(base)
    if latest is None:
        return None
    p = os.path.join(latest, name)
    return p if os.path.isfile(p) else None


def check_vtk(path):
    """Return list of failure strings (empty = pass)."""
    fails = []
    with open(path) as f:
        head = [next(f).rstrip("\n") for _ in range(4)]
    if head[0] != "# vtk DataFile Version 3.0":
        fails.append(f"unexpected VTK header: {head[0]!r}")
    if head[2] != "ASCII":
        fails.append(f"expected ASCII format, got {head[2]!r}")
    if head[3] != "DATASET POLYDATA":
        fails.append(f"expected DATASET POLYDATA, got {head[3]!r}")

    with open(path) as f:
        body = f.read()

    def section_count(keyword):
        m = re.search(rf"^{keyword}\s+(\d+)", body, re.MULTILINE)
        return int(m.group(1)) if m else None

    nPoints = section_count("POINTS")
    nLines = section_count("LINES")
    nPointData = section_count("POINT_DATA")
    nCellData = section_count("CELL_DATA")

    if not nPoints or not nLines:
        fails.append("missing POINTS or LINES section")
        return fails

    if nPointData != nPoints:
        fails.append(f"POINT_DATA={nPointData} != POINTS={nPoints}")
    if nCellData != nLines:
        fails.append(f"CELL_DATA={nCellData} != LINES={nLines}")

    for s in (
        "time_s", "dose_mJcm2", "cell",
        "trackId", "endReason", "finalDose_mJcm2",
    ):
        if f"SCALARS {s} " not in body:
            fails.append(f"missing scalar {s!r}")

    # finalDose_mJcm2 is per-line CELL_DATA. Pull its block and check
    # all values match the deterministic analytical dose of 2.0
    # mJ/cm^2 within floating-point tolerance.
    m = re.search(
        r"SCALARS finalDose_mJcm2 float 1\s*\nLOOKUP_TABLE default\s*\n"
        r"((?:[-\d.eE+]+\s*\n)+)",
        body,
    )
    if m is None:
        fails.append("could not parse finalDose_mJcm2 block")
    else:
        vals = [float(v) for v in m.group(1).split()]
        if len(vals) != nLines:
            fails.append(
                f"finalDose_mJcm2 has {len(vals)} entries, expected"
                f" {nLines} (one per line)"
            )
        if vals and max(abs(v - 2.0) for v in vals) > 1e-6:
            fails.append(
                f"finalDose_mJcm2 deviates from 2.0 by more than 1e-6"
                f" (max abs deviation"
                f" {max(abs(v - 2.0) for v in vals):.3e})"
            )

    return fails


def vtk_line_count(path):
    """Return integer LINES count from a legacy VTK file."""
    with open(path) as f:
        body = f.read()
    m = re.search(r"^LINES\s+(\d+)", body, re.MULTILINE)
    return int(m.group(1)) if m else None


def main():
    summary = find_latest("summary.dat")
    if summary is None:
        sys.stderr.write("validate: no summary.dat found\n")
        return 1

    data = parse_summary(summary)
    nSeeded = data.get("totalSeeded", 0)
    nEscaped = data.get("escaped", 0)
    minDose = data.get("minDose_mJcm2")
    maxDose = data.get("maxDose_mJcm2")
    meanDose = data.get("meanDose_mJcm2")
    stdevDose = data.get("stdevDose_mJcm2")
    print(f"validate: seeded      = {int(nSeeded)}")
    print(f"validate: escaped     = {int(nEscaped)}")
    print(f"validate: meanDose    = {meanDose} mJ/cm^2 (analytical = 2.0)")
    print(f"validate: stdevDose   = {stdevDose} mJ/cm^2")
    print(f"validate: min/max     = {minDose} / {maxDose} mJ/cm^2")

    failures = []
    # Plug flow with slip walls: every seeded particle must escape.
    if nSeeded < 1 or nEscaped != nSeeded:
        failures.append(
            f"escaped {int(nEscaped)} != seeded {int(nSeeded)} (plug flow"
            f" should escape all)"
        )
    if meanDose is None or abs(meanDose - 2.0) > 1e-3:
        failures.append(f"meanDose {meanDose} != 2.0 +/- 1e-3")
    # Spread should be floating-point noise; 1e-6 leaves headroom over
    # the 1e-13 we observe in practice without depending on the exact
    # arithmetic order.
    if stdevDose is None or stdevDose > 1e-6:
        failures.append(
            f"stdevDose {stdevDose} > 1e-6 (plug flow should be"
            f" deterministic)"
        )

    vtk = find_latest("trajectories.vtk")
    if vtk is None:
        failures.append("trajectories.vtk not found")
    else:
        print(f"validate: checking {os.path.basename(vtk)}")
        failures.extend(check_vtk(vtk))

    # Pre-write dose-range filter. Three sibling function-object
    # instances run the same simulation with different vtk{Min,Max}Dose
    # bounds; their trajectories.vtk LINES counts pin down the filter
    # semantics. The plug-flow dose is exactly 2.0 mJ/cm^2 everywhere.
    expected_lines = {
        "radiationDoseFilterKept":  int(nSeeded),  # [1, 3] keeps all
        "radiationDoseFilterOver":  0,             # min 5 > 2.0
        "radiationDoseFilterUnder": 0,             # max 1 < 2.0
    }
    for func, expected in expected_lines.items():
        v = find_latest("trajectories.vtk", func=func)
        if v is None:
            failures.append(f"{func}/trajectories.vtk not found")
            continue
        n = vtk_line_count(v)
        print(f"validate: {func} LINES = {n} (expected {expected})")
        if n != expected:
            failures.append(
                f"{func} LINES={n} != expected {expected}"
            )

    if failures:
        print("\nFAIL:")
        for f in failures:
            print(f"  - {f}")
        return 1

    print("\nPASS: dose accumulation and VTK writer both healthy")
    return 0


if __name__ == "__main__":
    sys.exit(main())
