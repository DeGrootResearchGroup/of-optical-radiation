/*--------------------------------*- C++ -*----------------------------------*\
  =========                 |
  \\      /  F ield         | radiationDose: DRW with epsilon or omega
   \\    /   O peration     |
    \\  /    A nd           |
     \\/     M anipulation  |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

// Uniform turbulence, k = 2^-5: fluctuations of sqrt(2k/3) ~ 0.14 m/s on
// the 0.5 m/s plug flow, gentle enough that every track reaches the outlet.
// With epsilon = 2^-5 and omega = 2 (Cmu 0.5 in the omega instance),
// epsilon = Cmu k omega holds exactly in floating point, and both eddy
// lifetimes are Cl * 1.0 = 0.15 s exactly.
internalField   uniform 0.03125;

boundaryField
{
    inlet
    {
        type            zeroGradient;
    }
    outlet
    {
        type            zeroGradient;
    }
    walls
    {
        type            zeroGradient;
    }
}

