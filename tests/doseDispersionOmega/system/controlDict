FoamFile
{
    format      ascii;
    class       dictionary;
    object      controlDict;
}

application     postProcess;
startTime       0;
endTime         0;
deltaT          1;
writeControl    timeStep;
writeInterval   1;
purgeWrite      0;
writeFormat     ascii;
writePrecision  8;

// The same discrete random walk twice, from the same seed: once reading
// epsilon, once reading omega. The fields satisfy epsilon = Cmu k omega
// exactly (k 2^-5, epsilon 2^-5, omega 2, Cmu 0.5), so both give every eddy
// the lifetime 0.15 s and every particle the same dose; `validate` checks
// they agree track for track and that the walk actually spread the doses.

functions
{
    drwEpsilon
    {
        type            radiationDose;
        libs            ("libradiationDose.so");
        U               U;
        fluenceRate     G;
        seed            7;
        seeding         { type patchInjection; patches (inlet); nParticles 300; }
        dispersion
        {
            type        discreteRandomWalk;
            k           k;
            epsilon     epsilon;
            Cl          0.15;
        }
        termination     { escapePatches (outlet); maxTime 20; maxDose 0; }
        integration     { dtMax 0.05; cflMax 0.5; }
        output          { kInact (0.1); }
    }
    drwOmega
    {
        type            radiationDose;
        libs            ("libradiationDose.so");
        U               U;
        fluenceRate     G;
        seed            7;
        seeding         { type patchInjection; patches (inlet); nParticles 300; }
        dispersion
        {
            type        discreteRandomWalk;
            k           k;
            omega       omega;
            Cmu         0.5;
            Cl          0.15;
        }
        termination     { escapePatches (outlet); maxTime 20; maxDose 0; }
        integration     { dtMax 0.05; cflMax 0.5; }
        output          { kInact (0.1); }
    }
}

