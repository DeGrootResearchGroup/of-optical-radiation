FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "(G|Ii)"
    {
        solver          PBiCG;
        preconditioner  DILU;
        tolerance       1e-06;
        relTol          0;
    }
}

// foamMultiRun reads PIMPLE control via solver::read(); we have no
// inner-iteration physics, so a minimal entry is sufficient.
PIMPLE
{
    nNonOrthogonalCorrectors 0;
}

