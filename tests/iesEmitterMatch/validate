#!/usr/bin/env python3
"""
Validate the iesEmitter BC against the plane-parallel analytical
solution G(x) = 2*pi*L_w*E_2(kappa*x) per band.

Setup. With fixtureAxis aligned to the patch's inward normal (+x) and
a synthetic IES table of shape I(gamma) = cos(gamma) (gamma in [0, 90])
on a single horizontal angle, every emitting ray gets

    L_d = P / (A_patch * Phi_table) * I(gamma_d) * Omega_d / (dAve_d . n)

with Phi_table = sum over outgoing rays of I(gamma_d) * Omega_d. On the
2-D grid Omega_d = 2 dphi and dAve_d . n = pi sin(dphi/2) cos(phi_d), and
the cosine table makes L_d the same for every ray: exactly the radiance
of a Lambertian wall of exitance P / A_patch,

    L_w = P / (pi * A_patch),

because the BC emits exactly P. The DOM solve then yields the same
plane-parallel profile a `diffuseEmitter` would, with the bands
contributing additively.

Failure of any one of: IES parsing, gamma/h frame conversion, table
interpolation, or renormalisation, breaks this match.

Assumes ./Allrun has been executed and 1/G is present.
"""

import os
import math
import statistics
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "lib"))
from foam_field import read_internal_scalar_field


# Same DOM angular tolerance as diffuseSlab2D / fvModelChannel2D.
TOLERANCE = 0.07


def E2(t: float) -> float:
    """Second exponential integral via midpoint rule on u = 1/mu."""
    if t == 0.0:
        return 1.0
    n = 10000
    return sum(math.exp(-t / ((k + 0.5) / n)) for k in range(n)) / n



def main() -> int:
    # Case parameters - must stay in sync with constant/opticalRadiationProperties,
    # 0.orig/I (radSource block), and system/blockMeshDict.
    KAPPA = 1.0
    POWER_PER_BAND = 0.005      # W
    N_BANDS = 2
    N_PHI = 8
    NX, NY = 100, 10
    LY, LZ = 0.1, 0.01          # patch is in y-z plane at x = 0
    A_PATCH = LY * LZ           # m^2

    L_w = POWER_PER_BAND / (math.pi * A_PATCH)
    G_ref_factor = N_BANDS * 2.0 * math.pi * L_w

    vals = read_internal_scalar_field("1/G")
    expected = NX * NY
    if len(vals) != expected:
        sys.exit(
            f"validate: expected {expected} cells, got {len(vals)} - "
            "mesh may have changed"
        )

    # Average over y at each x (cell ordering is x-fastest, then y).
    profile = [
        statistics.mean(vals[ix + iy * NX] for iy in range(NY)) for ix in range(NX)
    ]

    sample_indices = [0, 10, 20, 50, 99]
    rows = []
    max_err = 0.0
    for ix in sample_indices:
        x = (ix + 0.5) / NX
        G_sim = profile[ix]
        G_ana = G_ref_factor * E2(KAPPA * x)
        err = abs(G_sim - G_ana) / G_ana
        rows.append((x, G_sim, G_ana, err))
        max_err = max(max_err, err)

    print(f"L_w = P/(pi*A_patch) = {L_w:.6f} W/m^2/sr")
    print(f"{'x [m]':>6}  {'G_sim':>12}  {'G_analytical':>14}  {'rel_err':>10}")
    for x, gs, ga, e in rows:
        print(f"{x:6.4f}  {gs:12.4e}  {ga:14.4e}  {e:10.2%}")
    print(f"max relative error: {max_err:.2%}  tolerance: {TOLERANCE:.2%}")

    return 0 if max_err <= TOLERANCE else 1


if __name__ == "__main__":
    sys.exit(main())
