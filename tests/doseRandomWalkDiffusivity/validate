#!/usr/bin/env python3
"""The discrete random walk spreads particles with the diffusivity of its eddies.

In homogeneous turbulence a walk of eddies held for tau_e, each with an
independent N(0, sigma^2) velocity per component (sigma^2 = 2k/3), moves a
particle by sigma tau_e N(0, 1) per eddy. After a time T of n whole eddies
the mean-square displacement per component is exactly

    n sigma^2 tau_e^2 = sigma^2 tau_e T = 2 K T,   K = k tau_e / 3,

whatever the outer step. 2000 particles start at the centre of a closed
200 mm cube (k = 0.03, sigma^2 = 0.02) and walk for T = 1 s, in four
instances from the same seed:

  shortWellMixed / shortUncorrected   tau_e = 0.1 ms, 50 eddies per 5 ms step
  longWellMixed  / longUncorrected    tau_e = 50 ms, with cflMax 0.1, so the
                                      CFL bound shortens most steps

This checks:

  1. every track was walked to 1 s;
  2. the corrected walk realises 2 K T in both (to 8 %; the standard error
     of the estimate is sqrt(2 / 6000) = 1.8 %), with no mean drift; and so
     does the random displacement model with the same K
     (shortRandomDisplacement, longRandomDisplacement), whose Gaussian
     increments give 2 K T at any T. In the long case its own step limit
     binds (cflMax 0.4), and a CFL bound that saw its random draw would make
     the large draws take short steps and spread too little;
  3. the Langevin model (shortLangevin, longLangevin, earlyLangevin) matches
     the closed form for an Ornstein-Uhlenbeck velocity with a stationary
     start, 2 sigma^2 T_L (t - T_L (1 - e^-t/T_L)) with T_L = tau_e / 2: 2KT
     in the short case (T_L below its minLagrangianTime, so the diffusion
     limit), 0.975 of it in the long, and 0.176 of 2Kt at t = 10 ms < T_L,
     where its velocity memory shows; the corrected walk at the same time
     gives exactly t / tau_e = 0.2 (one eddy, held since t = 0), and a walk
     without memory would give 1;
  4. the uncorrected walk does not -- these are the controls. With
     tau_e below the step it resamples once per step and holds u' for the
     whole step, so its diffusivity is set by the step, not by tau_e (about
     sigma^2 dt / 2: some 20 times too large with the CFL-shortened steps);
     with tau_e above it, it ages each eddy by dtMax when the CFL bound has
     shortened the step, so eddies expire early and it spreads too little.

The particles spread about 1.4 mm (short) and 32 mm (long) in each
component, so the walls 100 mm away barely matter. Each track ends exactly
at maxTime: the tracker cuts the last step to the time left.
"""

import os
import sys

import numpy as np

HERE = os.path.dirname(os.path.abspath(__file__))
CENTRE = np.array([0.1025, 0.1025, 0.1025])
SIGMA2, T = 0.02, 1.0
TAU = {"short": 1.0e-4, "long": 0.05}
TOL = 0.08


def ends(func):
    path = os.path.join(HERE, "postProcessing", func, "0", "doseDistribution.csv")
    rows = np.genfromtxt(path, delimiter=",", comments="#", dtype=str)
    return rows[:, 1], rows[:, 2].astype(float), rows[:, 4:7].astype(float)


def ou_ratio(t, tl):
    """Mean-square displacement of an Ornstein-Uhlenbeck velocity with a
    stationary start, 2 sigma^2 T_L (t - T_L (1 - e^-t/T_L)), over
    sigma^2 tau_e t = 2 sigma^2 T_L t (tau_e = 2 T_L)."""
    return (t - tl * (1 - np.exp(-t / tl))) / t


# (instance, tau_e, run time, expected ratio, or a control's bound)
CASES = [
    ("shortWellMixed", TAU["short"], T, 1.0),
    ("shortRandomDisplacement", TAU["short"], T, 1.0),
    ("shortLangevin", TAU["short"], T, 1.0),
    ("longWellMixed", TAU["long"], T, 1.0),
    ("longRandomDisplacement", TAU["long"], T, 1.0),
    ("longLangevin", TAU["long"], T, ou_ratio(T, TAU["long"] / 2)),
    ("earlyLangevin", TAU["long"], 0.01, ou_ratio(0.01, TAU["long"] / 2)),
    ("earlyWellMixed", TAU["long"], 0.01, 0.01 / TAU["long"]),
    ("shortUncorrected", TAU["short"], T, ("> 5", lambda r: r > 5)),
    ("longUncorrected", TAU["long"], T, ("< 0.6", lambda r: r < 0.6)),
]

fails = []
for func, tau, t_run, expect in CASES:
    try:
        reason, t_end, x_end = ends(func)
    except (OSError, ValueError, IndexError) as e:
        print(f"FAIL: cannot read {func}'s doseDistribution.csv: {e}")
        sys.exit(1)
    if len(reason) < 1990 or np.any(reason != "timedOut") or np.any(np.abs(t_end - t_run) > 1e-6):
        fails.append(f"{func}: {len(reason)} tracks, not every one walked to {t_run} s")
    dx = x_end - CENTRE
    msd = np.mean(dx**2)
    ratio = msd / (SIGMA2 * tau * t_run)
    drift = dx.mean(axis=0) / np.sqrt(msd / len(dx))
    if isinstance(expect, tuple):
        label, ok = expect
        print(f"  {func}: mean-square displacement / (sigma^2 tau_e t) = {ratio:.4f} (control: {label})")
        if not ok(ratio):
            fails.append(f"{func}: {ratio:.3f} of 2 K t; the control should be {label}")
        continue
    print(f"  {func}: mean-square displacement / (sigma^2 tau_e t) = {ratio:.4f}, expected"
          f" {expect:.4f}; mean / standard error {np.round(drift, 2).tolist()}")
    if abs(ratio / expect - 1) > TOL:
        fails.append(f"{func}: mean-square displacement {ratio:.4f} of 2 K t, expected {expect:.4f}"
                     f" (allowed {TOL:.0%})")
    if np.max(np.abs(drift)) > 4.5:
        fails.append(f"{func}: mean displacement {np.round(drift, 2).tolist()} standard"
                     " errors: a drift in homogeneous turbulence")

if fails:
    for f in fails:
        print("FAIL:", f)
    sys.exit(1)
print("PASS: the three walks realise K = k tau_e / 3, and the Langevin model and the corrected"
      " walk their own short-time spreading")
