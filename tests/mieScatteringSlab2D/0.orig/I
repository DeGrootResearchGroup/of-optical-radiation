FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      I;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 0 -3 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    radSource
    {
        // Lambertian emitter. emissivePower = 5 W/m^2 -> radiance = 5/pi.
        type            diffuseEmitter;
        nBands          1;
        emissivePower   (5);
        value           uniform 0;
    }
    radOut
    {
        // Black absorber.
        type            reflective;
        diffuseFraction 0;
        reflectionCoef  0;
        refValue        uniform 0;
        refGradient     uniform 0;
        valueFraction   uniform 1;
        value           uniform 0;
    }
    sides
    {
        // Specular mirrors -> 1-D plane-parallel.
        type            reflective;
        diffuseFraction 0;
        reflectionCoef  1;
        refValue        uniform 0;
        refGradient     uniform 0;
        valueFraction   uniform 1;
        value           uniform 0;
    }
    frontAndBack
    {
        type            empty;
    }
}

