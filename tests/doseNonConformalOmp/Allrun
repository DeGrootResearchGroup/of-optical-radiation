#!/bin/sh
. "$(dirname "$0")/../lib/AllrunPreamble.sh"

# Restore stock initial fields BEFORE createNonConformalCouples so the
# utility can read AMI_L / AMI_R as ordinary patches and rewrite their
# field BCs to nonConformalCyclic in place.
rm -rf 0
cp -r 0.orig 0

runApplication blockMesh
runApplication createNonConformalCouples -fields AMI_L AMI_R

# The point of the case: the threaded tracking path. Four threads is
# more than one whatever the host, and oversubscribing a smaller
# runner still interleaves the threads preemptively.
export OMP_NUM_THREADS=4
runApplication foamPostProcess

