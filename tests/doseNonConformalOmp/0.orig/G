FoamFile
{
    format      ascii;
    class       volScalarField;
    object      G;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 0 -3 0 0 0 0];

// Uniform fluence rate: every particle that crosses the coupling and
// escapes has dose G * (L / U) * 0.1 = 10 * 2 * 0.1 = 2.0 mJ/cm^2.
internalField   uniform 10;

boundaryField
{
    inlet
    {
        type            zeroGradient;
    }
    outlet
    {
        type            zeroGradient;
    }
    walls
    {
        type            zeroGradient;
    }
    AMI_L
    {
        type            zeroGradient;
    }
    AMI_R
    {
        type            zeroGradient;
    }
}

