FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      opticalRadiationProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

opticalRadiation        on;
radiationModel   DOM;

DOMCoeffs
{
    nPhi          8;     // azimuthal divisions per pi (total 2*nPhi over [0,2pi))
    nTheta        1;     // polar divisions; must be 1 in 2-D
    convergence   1e-9;
    maxIter       200;
    nBand         2;
    nPixelPhi     1;
    nPixelTheta   1;

    // Record the incident flux on these patches as the field qin.
    // sides is deliberately left out: qin must stay zero there.
    incidentFluxPatches (radOut radSource);
}

extinctionModel transparent;
transparentCoeffs
{
    nBands           2;
}

