#!/usr/bin/env python3
"""
Validate the fvModel-embedded run against the same plane-parallel
analytical reference used by diffuseSlab2D
(G(x) = 2*pi*L_w*E_2(kappa*x), per band, summed over bands).

The radiation problem here is identical to diffuseSlab2D. The flow
host (incompressibleFluid via foamRun) is just there to invoke the
fvModel each step. If the fvModel is wired up correctly, G must match
the analytical reference within the same tolerance the standalone
solver achieves on diffuseSlab2D.

Assumes ./Allrun has already been executed.
"""

import math
import os
import statistics
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "lib"))
from foam_field import read_internal_scalar_field


TOLERANCE = 0.07  # same as diffuseSlab2D; fvModel must not loosen accuracy


def E2(t: float) -> float:
    if t == 0.0:
        return 1.0
    n = 10000
    return sum(math.exp(-t / ((k + 0.5) / n)) for k in range(n)) / n


def latest_time_dir() -> str:
    """Find the largest-time output directory in the cwd."""
    candidates = []
    for name in os.listdir("."):
        if not os.path.isdir(name):
            continue
        try:
            t = float(name)
        except ValueError:
            continue
        if t > 0 and os.path.isfile(os.path.join(name, "G")):
            candidates.append((t, name))
    if not candidates:
        sys.exit("validate: no time directory containing G found")
    candidates.sort()
    return candidates[-1][1]


def main() -> int:
    # Case parameters - must match constant/opticalRadiationProperties and 0.orig/I.
    KAPPA = 1.0
    EMISSIVE_PER_BAND = 5.0
    N_BANDS = 2
    NX, NY = 100, 10

    L_w = EMISSIVE_PER_BAND / math.pi
    G_ref_factor = N_BANDS * 2.0 * math.pi * L_w

    t_dir = latest_time_dir()
    vals = read_internal_scalar_field(os.path.join(t_dir, "G"))
    expected = NX * NY
    if len(vals) != expected:
        sys.exit(
            f"validate: expected {expected} cells, got {len(vals)} - "
            "mesh may have changed"
        )

    # Average over y at each x (cell ordering is x-fastest, then y).
    profile = [
        statistics.mean(vals[ix + iy * NX] for iy in range(NY)) for ix in range(NX)
    ]

    sample_indices = [0, 10, 20, 50, 99]
    rows = []
    max_err = 0.0
    for ix in sample_indices:
        x = (ix + 0.5) / NX
        G_sim = profile[ix]
        G_ana = G_ref_factor * E2(KAPPA * x)
        err = abs(G_sim - G_ana) / G_ana
        rows.append((x, G_sim, G_ana, err))
        max_err = max(max_err, err)

    print(f"validating against G at t = {t_dir}")
    print(f"{'x [m]':>6}  {'G_sim':>12}  {'G_analytical':>14}  {'rel_err':>10}")
    for x, gs, ga, e in rows:
        print(f"{x:6.4f}  {gs:12.4e}  {ga:14.4e}  {e:10.2%}")
    print(f"max relative error: {max_err:.2%}  tolerance: {TOLERANCE:.2%}")

    return 0 if max_err <= TOLERANCE else 1


if __name__ == "__main__":
    sys.exit(main())
