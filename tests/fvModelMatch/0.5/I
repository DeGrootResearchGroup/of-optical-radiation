FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0.5";
    object      I;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 0 -3 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    radSource
    {
        type            diffuseEmitter;
        refValue        nonuniform List<scalar> 10(2.263475e-313 0 0 0 0 0 0 0 0 0);
        refGradient     nonuniform List<scalar> 10(1.390661e-309 1.390661e-309 9.271192e-310 9.271192e-310 0 0 0 0 0 0);
        valueFraction   nonuniform List<scalar> 10(1.390661e-309 1.390661e-309 0 0 0 0 0 0 0 0);
        value           nonuniform List<scalar> 10(1.390661e-309 1.390661e-309 0 0 0 0 0 0 0 0);
        nBands          2;
        emissivePower   2{5};
    }
    radOut
    {
        type            reflective;
        refValue        uniform 0;
        refGradient     uniform 0;
        valueFraction   uniform 1;
        value           uniform 0;
        reflectionCoef   0;
        diffuseFraction   0;
    }
    sides
    {
        type            reflective;
        refValue        uniform 0;
        refGradient     uniform 0;
        valueFraction   uniform 1;
        value           uniform 0;
        reflectionCoef   1;
        diffuseFraction   0;
    }
    frontAndBack
    {
        type            empty;
    }
}


